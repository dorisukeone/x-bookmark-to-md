# Required by Claude Code CLI in the daily automation workflow.
CLAUDE_CODE_OAUTH_TOKEN=

# GH_TOKEN is supplied automatically by GitHub Actions.

# Optional: pulls anonymous GA4 usage data (active users, event counts) into the
# daily report. Leave unset to skip this section entirely. See docs/ga4-setup.md.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_EMAIL=
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=
